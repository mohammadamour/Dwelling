# =============================================================================
# Dwelling API Server Environment Configuration Template
# Copy this file to .env and configure your local/production environment values.
# DO NOT commit real secrets or production credentials to source control.
# =============================================================================

# Server Port Configuration
PORT=5001
NODE_ENV=development

# Database Connection (Supabase PostgreSQL)
# Transaction-mode pooler (port 6543) for runtime application queries — scales to high concurrency.
# The ?pgbouncer=true parameter is required when using Supabase's PgBouncer transaction-mode pooler.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session-mode connection (port 5432) for schema migrations and DDL operations.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication Security (REQUIRED)
# Generate a cryptographically secure random 64-character hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key

# Allowed CORS Origins (comma-separated list of authorized domains)
# Example: https://dwelling.app,https://admin.dwelling.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:5001
