{
  "version": 2,
  "outputDirectory": "FrontEnd",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/register",
      "destination": "/pages/register.html"
    },
    {
      "source": "/properties",
      "destination": "/pages/properties.html"
    },
    {
      "source": "/property-details",
      "destination": "/pages/property-details.html"
    },
    {
      "source": "/profile",
      "destination": "/pages/profile.html"
    },
    {
      "source": "/add-property",
      "destination": "/pages/add-property.html"
    },
    {
      "source": "/pages/:page",
      "destination": "/pages/:page.html"
    }
  ]
}
